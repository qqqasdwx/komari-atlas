{
  "name": "Komari Atlas",
  "short": "atlas",
  "description": "A customizable monitoring theme for Komari Monitor",
  "version": "0.1.1",
  "author": "qqqasdwx",
  "url": "https://github.com/qqqasdwx/komari-atlas",
  "preview": "preview.png",
  "configuration": {
    "type": "managed",
    "name": "主题设置",
    "icon": "Palette",
    "data": [
      {
        "type": "title",
        "name": {
          "zh-CN": "基础设置",
          "zh-TW": "基本設定",
          "en-US": "General"
        }
      },
      {
        "key": "colorTheme",
        "type": "select",
        "name": {
          "zh-CN": "配色方案",
          "zh-TW": "配色方案",
          "en-US": "Color Scheme"
        },
        "help": {
          "zh-CN": "设置访客首次打开页面时使用的配色，访客仍可在浏览器中自行切换。",
          "zh-TW": "設定訪客首次開啟頁面時使用的配色，訪客仍可在瀏覽器中自行切換。",
          "en-US": "Sets the initial color scheme. Visitors can still override it in their browser."
        },
        "default": "default",
        "options": "default,ocean,sunset,forest,midnight,rose"
      },
      {
        "key": "appearance",
        "type": "select",
        "name": {
          "zh-CN": "外观模式",
          "zh-TW": "外觀模式",
          "en-US": "Appearance"
        },
        "help": {
          "zh-CN": "light 为浅色，dark 为深色，system 跟随访客系统。",
          "zh-TW": "light 為淺色，dark 為深色，system 跟隨訪客系統。",
          "en-US": "Choose light, dark, or system to follow the visitor's device."
        },
        "default": "system",
        "options": "light,dark,system"
      },
      {
        "key": "language",
        "type": "select",
        "name": {
          "zh-CN": "界面语言",
          "zh-TW": "介面語言",
          "en-US": "Interface Language"
        },
        "help": {
          "zh-CN": "auto 跟随访客浏览器语言。",
          "zh-TW": "auto 跟隨訪客瀏覽器語言。",
          "en-US": "Use auto to follow the visitor's browser language."
        },
        "default": "auto",
        "options": "auto,en,zh-CN,zh-TW"
      },
      {
        "key": "nodeViewMode",
        "type": "select",
        "name": {
          "zh-CN": "节点展示方式",
          "zh-TW": "節點顯示方式",
          "en-US": "Node View"
        },
        "help": {
          "zh-CN": "grid 使用卡片，table 使用表格。",
          "zh-TW": "grid 使用卡片，table 使用表格。",
          "en-US": "Use grid for cards or table for a compact list."
        },
        "default": "grid",
        "options": "grid,table"
      },
      {
        "type": "title",
        "name": {
          "zh-CN": "节点卡片",
          "zh-TW": "節點卡片",
          "en-US": "Node Cards"
        }
      },
      {
        "key": "cardLayout",
        "type": "select",
        "name": {
          "zh-CN": "卡片布局",
          "zh-TW": "卡片版面",
          "en-US": "Card Layout"
        },
        "help": {
          "zh-CN": "可选 classic、modern、minimal、detailed 或 compact。",
          "zh-TW": "可選 classic、modern、minimal、detailed 或 compact。",
          "en-US": "Choose classic, modern, minimal, detailed, or compact."
        },
        "default": "classic",
        "options": "classic,modern,minimal,detailed,compact"
      },
      {
        "key": "cardDesign",
        "type": "select",
        "name": {
          "zh-CN": "延迟展示",
          "zh-TW": "延遲顯示",
          "en-US": "Latency Display"
        },
        "help": {
          "zh-CN": "default 显示文本统计，quality-bars 显示延迟与丢包历史块。",
          "zh-TW": "default 顯示文字統計，quality-bars 顯示延遲與丟包歷史區塊。",
          "en-US": "Use default for text statistics or quality-bars for latency and packet-loss history."
        },
        "default": "default",
        "options": "default,quality-bars"
      },
      {
        "key": "graphDesign",
        "type": "select",
        "name": {
          "zh-CN": "资源图表",
          "zh-TW": "資源圖表",
          "en-US": "Resource Charts"
        },
        "help": {
          "zh-CN": "可选 circle、progress、bar 或 minimal。",
          "zh-TW": "可選 circle、progress、bar 或 minimal。",
          "en-US": "Choose circle, progress, bar, or minimal."
        },
        "default": "circle",
        "options": "circle,progress,bar,minimal"
      },
      {
        "key": "showRamDiskTotal",
        "type": "switch",
        "name": {
          "zh-CN": "显示内存与磁盘总量",
          "zh-TW": "顯示記憶體與磁碟總量",
          "en-US": "Show RAM and Disk Totals"
        },
        "default": false
      },
      {
        "key": "cardBlurEnabled",
        "type": "switch",
        "name": {
          "zh-CN": "启用卡片背景效果",
          "zh-TW": "啟用卡片背景效果",
          "en-US": "Enable Card Background Effects"
        },
        "default": false
      },
      {
        "key": "cardBlurType",
        "type": "select",
        "name": {
          "zh-CN": "卡片材质",
          "zh-TW": "卡片材質",
          "en-US": "Card Material"
        },
        "help": {
          "zh-CN": "soft 为轻柔虚化，glass 为玻璃质感。",
          "zh-TW": "soft 為輕柔虛化，glass 為玻璃質感。",
          "en-US": "Use soft for subtle blur or glass for a stronger glass effect."
        },
        "default": "glass",
        "options": "soft,glass"
      },
      {
        "key": "cardBlurIntensity",
        "type": "number",
        "name": {
          "zh-CN": "卡片透明强度",
          "zh-TW": "卡片透明強度",
          "en-US": "Card Transparency"
        },
        "help": {
          "zh-CN": "范围 0-100，数值越大背景越透明。",
          "zh-TW": "範圍 0-100，數值越大背景越透明。",
          "en-US": "Range 0-100. Higher values make the background more transparent."
        },
        "default": 35
      },
      {
        "key": "cardExtraBlurIntensity",
        "type": "number",
        "name": {
          "zh-CN": "卡片模糊强度",
          "zh-TW": "卡片模糊強度",
          "en-US": "Card Blur"
        },
        "help": {
          "zh-CN": "范围 0-100，数值越大模糊效果越强。",
          "zh-TW": "範圍 0-100，數值越大模糊效果越強。",
          "en-US": "Range 0-100. Higher values increase the blur effect."
        },
        "default": 35
      },
      {
        "type": "title",
        "name": {
          "zh-CN": "背景效果",
          "zh-TW": "背景效果",
          "en-US": "Background"
        }
      },
      {
        "key": "backgroundImageUrl",
        "type": "string",
        "name": {
          "zh-CN": "背景图片链接",
          "zh-TW": "背景圖片連結",
          "en-US": "Background Image URL"
        },
        "help": {
          "zh-CN": "填写可公开访问的图片 URL，留空则使用默认背景。",
          "zh-TW": "填寫可公開存取的圖片 URL，留空則使用預設背景。",
          "en-US": "Enter a publicly accessible image URL, or leave blank for the default background."
        },
        "default": ""
      },
      {
        "key": "backgroundBlurEnabled",
        "type": "switch",
        "name": {
          "zh-CN": "启用背景模糊",
          "zh-TW": "啟用背景模糊",
          "en-US": "Enable Background Blur"
        },
        "default": false
      },
      {
        "key": "backgroundBlurType",
        "type": "select",
        "name": {
          "zh-CN": "背景模糊类型",
          "zh-TW": "背景模糊類型",
          "en-US": "Background Blur Type"
        },
        "help": {
          "zh-CN": "soft 为轻柔虚化，glass 为更强的玻璃效果。",
          "zh-TW": "soft 為輕柔虛化，glass 為更強的玻璃效果。",
          "en-US": "Use soft for subtle blur or glass for a stronger glass effect."
        },
        "default": "soft",
        "options": "soft,glass"
      },
      {
        "key": "backgroundBlurIntensity",
        "type": "number",
        "name": {
          "zh-CN": "背景模糊强度",
          "zh-TW": "背景模糊強度",
          "en-US": "Background Blur"
        },
        "help": {
          "zh-CN": "范围 0-100。",
          "zh-TW": "範圍 0-100。",
          "en-US": "Range 0-100."
        },
        "default": 35
      },
      {
        "key": "backgroundMaskOpacity",
        "type": "number",
        "name": {
          "zh-CN": "背景蒙版不透明度",
          "zh-TW": "背景遮罩不透明度",
          "en-US": "Background Mask Opacity"
        },
        "help": {
          "zh-CN": "范围 0-100，数值越大文字越清晰，100 会完全覆盖背景。",
          "zh-TW": "範圍 0-100，數值越大文字越清晰，100 會完全覆蓋背景。",
          "en-US": "Range 0-100. Higher values improve text readability; 100 fully covers the image."
        },
        "default": 0
      },
      {
        "type": "title",
        "name": {
          "zh-CN": "概览卡片",
          "zh-TW": "概覽卡片",
          "en-US": "Overview Cards"
        }
      },
      {
        "key": "statusDesign",
        "type": "select",
        "name": {
          "zh-CN": "网络速率样式",
          "zh-TW": "網路速率樣式",
          "en-US": "Network Speed Style"
        },
        "help": {
          "zh-CN": "default 显示文本，speed 显示仪表盘。",
          "zh-TW": "default 顯示文字，speed 顯示儀表板。",
          "en-US": "Use default for text or speed for a gauge."
        },
        "default": "default",
        "options": "default,speed"
      },
      {
        "key": "statusCardsVisibility.currentTime",
        "type": "switch",
        "name": {
          "zh-CN": "显示当前时间",
          "zh-TW": "顯示目前時間",
          "en-US": "Show Current Time"
        },
        "default": true
      },
      {
        "key": "statusCardsVisibility.currentOnline",
        "type": "switch",
        "name": {
          "zh-CN": "显示在线节点",
          "zh-TW": "顯示線上節點",
          "en-US": "Show Online Nodes"
        },
        "default": true
      },
      {
        "key": "statusCardsVisibility.regionOverview",
        "type": "switch",
        "name": {
          "zh-CN": "显示点亮地区",
          "zh-TW": "顯示點亮地區",
          "en-US": "Show Active Regions"
        },
        "default": true
      },
      {
        "key": "statusCardsVisibility.trafficOverview",
        "type": "switch",
        "name": {
          "zh-CN": "显示流量概览",
          "zh-TW": "顯示流量概覽",
          "en-US": "Show Traffic Overview"
        },
        "default": true
      },
      {
        "key": "statusCardsVisibility.networkSpeed",
        "type": "switch",
        "name": {
          "zh-CN": "显示网络速率",
          "zh-TW": "顯示網路速率",
          "en-US": "Show Network Speed"
        },
        "default": true
      },
      {
        "type": "title",
        "name": {
          "zh-CN": "游客权限",
          "zh-TW": "訪客權限",
          "en-US": "Guest Access"
        }
      },
      {
        "key": "guestDisplay.showPrice",
        "type": "switch",
        "name": {
          "zh-CN": "向游客显示价格",
          "zh-TW": "向訪客顯示價格",
          "en-US": "Show Prices to Guests"
        },
        "help": {
          "zh-CN": "开启后，未登录访客可以看到节点价格。",
          "zh-TW": "開啟後，未登入訪客可以看到節點價格。",
          "en-US": "Allows signed-out visitors to see node prices."
        },
        "default": false
      },
      {
        "key": "guestDisplay.showExpiredAt",
        "type": "switch",
        "name": {
          "zh-CN": "向游客显示到期时间",
          "zh-TW": "向訪客顯示到期時間",
          "en-US": "Show Expiration to Guests"
        },
        "help": {
          "zh-CN": "开启后，未登录访客可以看到节点到期状态。",
          "zh-TW": "開啟後，未登入訪客可以看到節點到期狀態。",
          "en-US": "Allows signed-out visitors to see node expiration status."
        },
        "default": false
      }
    ]
  }
}
